projection;
strict ;
 use side effects;
use draft;


define behavior for ZC_KF_EC_CLAIM //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action Submit;
  use action Withdraw;
  use action Approve;
  use action Reject;
  use action MarkAsPaid;
  use action CopyClaim;
  use action MassApprove;

  use association _line { create; with draft; }
}

define behavior for ZC_KF_EC_LINE //alias <alias_name>
{
  use update;
  use delete;



  use association _claim { with draft; }
  use association _RECEIPT { create; with draft;}
}

define behavior for ZC_KF_EC_RECEIPT //alias <alias_name>
{
  use update;
  use delete;

  use association _line { with draft; }
  use association _claim { with draft; }
}