@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName: 'Expense Claim',
    typeNamePlural: 'Expense Claims',
    title: {
      type: #STANDARD,
      value: 'claim_number'
    },
    description: {
      value: 'employee_name'
    }
  }
}

annotate entity ZC_KF_EC_CLAIM
    with
{

    @UI.facet: [
      {
      id              : 'ClaimDetails',
      purpose         : #STANDARD,
      type            : #FIELDGROUP_REFERENCE,
      label           : 'Claim Details',
      targetQualifier : 'ClaimDetails',
      position        : 9
    },
      {
        id              : 'TripDetails',
        purpose         : #STANDARD,
        type            : #FIELDGROUP_REFERENCE,
        label           : 'Trip Details',
        targetQualifier : 'TripDetails',
        position        : 10
      },
      {
        id            : 'ExpenseLines',
        purpose       : #STANDARD,
        type          : #LINEITEM_REFERENCE,
        label         : 'Expense Lines',
        targetElement : '_line',
        position      : 20
      },
      {
        id              : 'Administration',
        purpose         : #STANDARD,
        type            : #FIELDGROUP_REFERENCE,
        label           : 'Administration',
        targetQualifier : 'Administration',
        position        : 30
      }
    ]

    @EndUserText.label: 'Claim Number'
    @UI.lineItem: [{ position: 10 }]
    @UI.selectionField: [{ position: 10 }]
    @UI.fieldGroup: [{
  qualifier: 'ClaimDetails',
  position: 10
}]
    claim_number;

    @EndUserText.label: 'Employee Name'
    @UI.lineItem: [{ position: 20 }]
    @UI.selectionField: [{ position: 20 }]
    @UI.fieldGroup: [{
  qualifier: 'ClaimDetails',
  position: 20
}]
    employee_name;
    @EndUserText.label: 'Status'
    @UI.lineItem: [{ position: 30 }]
    @UI.selectionField: [{ position: 30 }]
    @UI.fieldGroup: [{
        qualifier : 'ClaimDetails',
        position  : 30
    }]
    status;
    @EndUserText.label: 'Trip Purpose'
    @UI.fieldGroup: [
      {
        qualifier : 'TripDetails',
        position  : 10
      }
    ]
    
    
    trip_purpose;

    @EndUserText.label: 'Destination Country'
    @UI.lineItem: [{ position: 40 }]
    @UI.selectionField: [{ position: 40 }]
    @UI.fieldGroup: [
      {
        qualifier : 'TripDetails',
        position  : 20
      }
    ]
    destination_country;

    @EndUserText.label: 'Trip Start'
    @UI.lineItem: [{ position: 50 }]
    @UI.fieldGroup: [
      {
        qualifier : 'TripDetails',
        position  : 30
      }
    ]
    
    @UI.selectionField: [{ position: 50 }]
    trip_start_date;

    @EndUserText.label: 'Trip End'
    @UI.lineItem: [{ position: 60 }]
    @UI.fieldGroup: [
      {
        qualifier : 'TripDetails',
        position  : 40
      }
    ]
    trip_end_date;

    @EndUserText.label: 'Currency'
    @UI.fieldGroup: [
      {
        qualifier : 'TripDetails',
        position  : 50
      }
    ]
    currency_code;

    @EndUserText.label: 'Total Amount'
    @UI.lineItem: [{ position: 70 }]
    @UI.fieldGroup: [{
  qualifier: 'ClaimDetails',
  position: 40
}]
    total_amount;

    @EndUserText.label: 'Created By'
    @UI.fieldGroup: [
      {
        qualifier : 'Administration',
        position  : 10
      }
    ]
    created_by;

    @EndUserText.label: 'Created At'
    @UI.fieldGroup: [
      {
        qualifier : 'Administration',
        position  : 20
      }
    ]
    created_at;

    @EndUserText.label: 'Last Changed By'
    @UI.fieldGroup: [
      {
        qualifier : 'Administration',
        position  : 30
      }
    ]
    last_changed_by;

    @EndUserText.label: 'Last Changed At'
    @UI.fieldGroup: [
      {
        qualifier : 'Administration',
        position  : 40
      }
    ]
    last_changed_at;
    
   

}